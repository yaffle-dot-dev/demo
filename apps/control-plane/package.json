{
  "name": "@yaffle/control-plane",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp exec tsx watch src/index.ts",
    "dev:hot": "vp exec tsx watch src/index.ts",
    "build": "vp pack src/index.ts --out-dir dist --format esm --target node25",
    "start": "vp node dist/index.mjs",
    "smoke": "vp test run src/routes/*.smoke.test.ts",
    "typecheck": "vp exec tsc --noEmit",
    "test": "vp test run",
    "db:generate": "vp exec drizzle-kit generate",
    "db:migrate": "vp exec drizzle-kit migrate",
    "backfill:environment-group-projections": "vp exec tsx src/scripts/backfill-environment-group-projections.ts",
    "backfill:run-group-workspace-metadata": "vp exec tsx src/scripts/backfill-run-group-workspace-metadata.ts",
    "gc:local-first": "vp exec tsx src/scripts/run-local-first-gc.ts",
    "migrate:org-broker-roles": "vp exec tsx src/scripts/migrate-org-broker-roles.ts",
    "token:warm-runner": "vp exec tsx src/scripts/generate-warm-runner-token.ts",
    "spawn:warm-runner-ecs": "vp exec tsx src/scripts/spawn-warm-runner-ecs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1011.0",
    "@aws-sdk/client-ecs": "^3.1011.0",
    "@aws-sdk/client-lambda": "^3.1011.0",
    "@aws-sdk/client-iam": "^3.1001.0",
    "@aws-sdk/client-kms": "^3.1001.0",
    "@aws-sdk/client-s3": "^3.1001.0",
    "@aws-sdk/client-ssm": "^3.1011.0",
    "@aws-sdk/client-sts": "^3.1001.0",
    "@aws-sdk/s3-request-presigner": "^3.1003.0",
    "@better-auth/api-key": "1.5.6",
    "@hono/node-server": "^2.0.2",
    "@octokit/webhooks": "^13.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.212.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.212.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.212.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.212.0",
    "@opentelemetry/resources": "^2.5.1",
    "@opentelemetry/sdk-logs": "^0.212.0",
    "@opentelemetry/sdk-metrics": "^2.5.1",
    "@opentelemetry/sdk-trace-base": "^2.5.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@yaffle/shared": "workspace:*",
    "better-auth": "1.5.6",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "jose": "^6.2.0",
    "minijinja-js": "^2.17.1",
    "octokit": "^4.1.0",
    "postgres": "^3.4.0",
    "smol-toml": "^1.3.1",
    "stripe": "^21.0.0",
    "uuidv7": "^1.1.0",
    "yaml": "^2.8.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@yaffle/test": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0"
  }
}
