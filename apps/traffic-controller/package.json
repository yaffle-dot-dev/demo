{
  "name": "@yaffle/traffic-controller",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp pack src/api-lambda.ts src/reconcile-lambda.ts --out-dir dist --format esm --target node25",
    "typecheck": "vp exec tsc --noEmit",
    "test": "vp test",
    "db:generate": "vp exec drizzle-kit generate",
    "db:migrate": "vp exec drizzle-kit migrate",
    "db:bootstrap-runtime-role": "vp exec tsx scripts/bootstrap-runtime-role.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1035.0",
    "@aws-sdk/client-sqs": "^3.1036.0",
    "@hookdeck/sdk": "^0.4.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.215.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.215.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-logs": "^0.215.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "drizzle-orm": "^0.45.1",
    "octokit": "^5.0.5",
    "postgres": "^3.4.9",
    "uuidv7": "^1.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@yaffle/test": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0"
  }
}
