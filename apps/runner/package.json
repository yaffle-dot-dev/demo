{
  "name": "@yaffle/runner",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp pack src/worker.ts src/warm-runner.ts src/scanner.ts src/scanner-lambda.ts --out-dir dist --format esm --target node25",
    "start": "vp node dist/worker.mjs",
    "start:warm": "vp node dist/warm-runner.mjs",
    "test": "vp test",
    "typecheck": "vp exec tsc --noEmit"
  },
  "dependencies": {
    "@yaffle/shared": "workspace:*",
    "tar-stream": "^3.1.8",
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@yaffle/test": "workspace:*",
    "typescript": "^5.7.0"
  }
}
