---
import Base from "../layouts/Base.astro"
import { Image } from "astro:assets"
import yaffleBird from "../images/yaffle-bird.png"
---

<Base title="Page Not Found - Yaffle">
  <div class="min-h-screen flex items-center justify-center px-6">
    <div class="text-center">
      <Image 
        src={yaffleBird} 
        alt="Lost Yaffle" 
        class="w-32 h-auto mx-auto mb-6 opacity-50"
      />
      <h1 class="text-4xl font-bold text-text mb-2">404</h1>
      <p class="text-lg text-text-muted mb-6">
        This page doesn't exist.
      </p>
      <a 
        href="/" 
        class="inline-block px-6 py-3 rounded-lg bg-yaffle-600 text-white font-medium hover:bg-yaffle-500 transition-colors"
      >
        Back to home
      </a>
    </div>
  </div>
</Base>
