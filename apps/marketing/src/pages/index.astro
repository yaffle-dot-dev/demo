---
import Base from "../layouts/Base.astro"
import { Image } from "astro:assets"
import yaffleBird from "../images/yaffle-bird.png"
---

<Base title="Yaffle - Preview your whole system">
  <!-- Nav -->
  <nav class="fixed top-0 left-0 right-0 z-50 border-b border-border-subtle bg-surface/80 backdrop-blur-sm">
    <div class="mx-auto max-w-6xl px-6 py-4 flex items-center justify-between">
      <a href="/" class="text-xl font-semibold text-text inline-flex items-baseline">
        y<span class="relative">affle<svg class="absolute -bottom-1 left-0 w-full h-3 -rotate-[5deg] origin-left" viewBox="0 0 40 10" fill="none" preserveAspectRatio="none"><path d="M0 6 Q20 0 40 5 L40 6 Q20 2 0 9 Z" fill="#fa2d2d"/></svg></span>
      </a>
      <div class="flex items-center gap-6">
        <a href="#how-it-works" class="text-sm text-text-muted hover:text-text transition-colors hidden md:block">
          How it works
        </a>
        <a href="#pricing" class="text-sm text-text-muted hover:text-text transition-colors">
          Pricing
        </a>
        <a 
          href="/app" 
          class="text-sm font-medium px-4 py-2 rounded-lg bg-yaffle-600 text-white hover:bg-yaffle-500 transition-colors"
        >
          Get started
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="pt-28 pb-12 px-6">
    <div class="mx-auto max-w-4xl text-center">
      <div class="relative mb-4">
        <Image src={yaffleBird} alt="Yaffle" class="absolute -left-4 md:-left-8 top-1/2 -translate-y-1/3 w-36 h-auto md:w-48 -z-10"/>
        <h1 class="text-4xl md:text-5xl font-bold text-text leading-tight">
          Preview your whole system,<br />
          <span class="text-yaffle-400">not just your code.</span>
        </h1>
      </div>
      
      <p class="text-lg text-text-muted max-w-xl mx-auto mb-8">
        Infra, code, monitoring, and more—together, before production.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-6">
        <a 
          href="/app" 
          class="w-full sm:w-auto px-6 py-3 rounded-lg bg-yaffle-600 text-white font-medium hover:bg-yaffle-500 transition-colors"
        >
          Start free &rarr;
        </a>
        <a 
          href="#how-it-works" 
          class="w-full sm:w-auto px-6 py-3 rounded-lg border border-border text-text-muted font-medium hover:border-yaffle-600 hover:text-text transition-colors"
        >
          See how it works
        </a>
      </div>
      
      <p class="text-sm text-text-dim">
        <a href="#pricing" class="text-yaffle-400 hover:underline">Free to get started</a>. No credit card required.
      </p>
    </div>
  </section>

  <!-- Value props -->
  <section class="py-8 px-6 border-t border-border-subtle">
    <div class="mx-auto max-w-4xl">
      <div class="grid md:grid-cols-3 gap-8 text-center">
        <div>
          <div class="text-lg font-semibold text-text">Test the whole system</div>
          <div class="text-base font-semibold text-text-muted">instead of just one component</div>
        </div>
        <div>
          <div class="text-lg font-semibold text-text">One environment per PR</div>
          <div class="text-base font-semibold text-text-muted">no more staging bottlenecks</div>
        </div>
        <div>
          <div class="text-lg font-semibold text-text">Ship with confidence</div>
          <div class="text-base font-semibold text-text-muted">whether humans or AI made the change</div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works - illustrated -->
  <section id="how-it-works" class="py-16 px-6 border-t border-border-subtle">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-2xl font-bold text-text text-center mb-12">
        How it works
      </h2>
      
      <!-- Step 1: Open a PR -->
      <div class="grid md:grid-cols-2 gap-8 items-center mb-16">
        <div class="order-2 md:order-1">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-8 h-8 rounded-full bg-yaffle-600 flex items-center justify-center text-white text-sm font-semibold">1</span>
            <h3 class="text-xl font-semibold text-text">Open a PR</h3>
          </div>
          <p class="text-text-muted mb-4">
            Push your changes and open a pull request. Yaffle automatically detects infrastructure changes and spins up an isolated preview environment.
          </p>
          <ul class="space-y-2 text-sm text-text-muted">
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-yaffle-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Works with your existing Terraform
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-yaffle-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Isolated state per PR
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-yaffle-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Real infrastructure, not mocks
            </li>
          </ul>
        </div>
        <div class="order-1 md:order-2">
          <!-- Illustration: GitHub PR -> Yaffle -> Preview -->
          <div class="relative p-6 rounded-xl bg-surface-raised border border-border">
            <div class="flex items-center justify-between gap-4">
              <!-- GitHub PR -->
              <div class="flex flex-col items-center gap-2">
                <div class="w-16 h-16 rounded-lg bg-surface-overlay border border-border flex items-center justify-center">
                  <svg class="w-8 h-8 text-text-muted" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                  </svg>
                </div>
                <span class="text-xs text-text-dim">PR #69</span>
              </div>
              
              <!-- Arrow -->
              <svg class="w-8 h-8 text-text-dim flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
              
              <!-- Yaffle -->
              <div class="flex flex-col items-center gap-2">
                <div class="w-24 h-24 rounded-lg bg-yaffle-950 border border-yaffle-700 flex items-center justify-center">
                  <Image src={yaffleBird} alt="Yaffle" class="w-full h-full object-contain"/>
                </div>
                <span class="text-xs text-yaffle-400">Yaffle</span>
              </div>
              
              <!-- Arrow -->
              <svg class="w-8 h-8 text-text-dim flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
              
              <!-- Preview Environment -->
              <div class="flex flex-col items-center gap-2">
                <div class="w-16 h-16 rounded-lg bg-surface-overlay border border-yaffle-600 border-dashed flex items-center justify-center">
                  <svg class="w-8 h-8 text-yaffle-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/>
                  </svg>
                </div>
                <span class="text-xs text-text-dim">Preview</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Step 2: Deploy & test -->
      <div class="grid md:grid-cols-2 gap-8 items-center mb-16">
        <div class="order-2 md:order-1">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-8 h-8 rounded-full bg-yaffle-600 flex items-center justify-center text-white text-sm font-semibold">2</span>
            <h3 class="text-xl font-semibold text-text">Deploy & test</h3>
          </div>
          <p class="text-text-muted mb-4">
            Use our GitHub Action to fetch Terraform outputs from your preview environment. Deploy your application onto real infrastructure and run your full test suite.
          </p>
          <ul class="space-y-2 text-sm text-text-muted">
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-yaffle-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Real database connections
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-yaffle-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              End-to-end integration tests
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-yaffle-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Preview URLs for manual QA
            </li>
          </ul>
        </div>
        <div class="order-1 md:order-2">
          <!-- Illustration: Action fetches outputs, deploys app -->
          <div class="relative p-6 rounded-xl bg-surface-raised border border-border">
            <div class="space-y-4">
              <!-- GitHub Action -->
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-surface-overlay border border-border flex items-center justify-center">
                  <svg class="w-5 h-5 text-text-muted" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <div class="text-sm font-medium text-text">GitHub Actions</div>
                  <div class="text-xs text-text-dim font-mono">yaffle-dev/outputs-action</div>
                </div>
              </div>
              
              <!-- Arrow down -->
              <div class="flex justify-center">
                <svg class="w-6 h-6 text-cream-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                </svg>
              </div>
              
              <!-- Outputs -->
              <div class="rounded-lg bg-surface-overlay border border-border p-3 font-mono text-xs">
                <div class="text-text-dim"># Outputs from preview infra</div>
                <div><span class="text-yaffle-400">database_url:</span> <span class="text-cream-400">postgres://pr-69.xxx</span></div>
                <div><span class="text-yaffle-400">api_endpoint:</span> <span class="text-cream-400">https://pr-69.api.xxx</span></div>
              </div>
              
              <!-- Arrow down -->
              <div class="flex justify-center">
                <svg class="w-6 h-6 text-yaffle-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                </svg>
              </div>
              
              <!-- Your app deployed -->
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-yaffle-900 border border-yaffle-600 flex items-center justify-center">
                  <svg class="w-5 h-5 text-yaffle-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <div class="text-sm font-medium text-yaffle-400">Your App</div>
                  <div class="text-xs text-text-dim">Deployed on preview infra</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Step 3: Merge safely -->
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div class="order-2 md:order-1">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-8 h-8 rounded-full bg-yaffle-600 flex items-center justify-center text-white text-sm font-semibold">3</span>
            <h3 class="text-xl font-semibold text-text">Merge safely</h3>
          </div>
          <p class="text-text-muted mb-4">
            When you merge, Yaffle applies the exact same plan to production. No drift, no surprises. The preview environment is automatically cleaned up.
          </p>
          <ul class="space-y-2 text-sm text-text-muted">
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-yaffle-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Same plan, same state
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-yaffle-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Automatic cleanup
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-yaffle-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Full audit trail
            </li>
          </ul>
        </div>
        <div class="order-1 md:order-2">
          <!-- Illustration: PR merged -> Yaffle -> Production -->
          <div class="relative p-6 rounded-xl bg-surface-raised border border-border">
            <div class="flex items-center justify-between gap-4">
              <!-- Merged PR -->
              <div class="flex flex-col items-center gap-2">
                <div class="w-16 h-16 rounded-lg bg-surface-overlay border border-yaffle-600 flex items-center justify-center">
                  <svg class="w-8 h-8 text-yaffle-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span class="text-xs text-yaffle-400">Merged</span>
              </div>
              
              <!-- Arrow -->
              <svg class="w-8 h-8 text-text-dim flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
              
              <!-- Yaffle -->
              <div class="flex flex-col items-center gap-2">
                <div class="w-24 h-24 rounded-lg bg-yaffle-950 border border-yaffle-700 flex items-center justify-center">
                  <Image src={yaffleBird} alt="Yaffle" class="w-full h-full object-contain"/>
                </div>
                <span class="text-xs text-yaffle-400">Yaffle</span>
              </div>
              
              <!-- Arrow -->
              <svg class="w-8 h-8 text-text-dim flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
              
              <!-- Production -->
              <div class="flex flex-col items-center gap-2">
                <div class="w-16 h-16 rounded-lg bg-yaffle-900 border-2 border-yaffle-500 flex items-center justify-center">
                  <svg class="w-8 h-8 text-yaffle-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/>
                  </svg>
                </div>
                <span class="text-xs text-yaffle-400 font-medium">Production</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing - moved up, realistic tiers -->
  <section id="pricing" class="py-12 px-6 border-t border-border-subtle bg-surface-raised/50">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-bold text-text text-center mb-2">
        Simple, transparent pricing
      </h2>
      <p class="text-text-muted text-center mb-8">
        Pay for what you use. Cancel anytime.
      </p>
      
      <div class="grid md:grid-cols-3 gap-6 items-stretch">
        <!-- Free -->
        <div class="p-6 rounded-xl bg-surface-raised border border-border flex flex-col">
          <h3 class="text-lg font-semibold text-text mb-1">Free</h3>
          <p class="text-text-dim text-sm mb-4">To get started</p>
          <div class="text-3xl font-bold text-text mb-4">
            $0<span class="text-sm font-normal text-text-dim">/mo</span>
          </div>
          <ul class="space-y-2 text-sm text-text-muted mb-6 flex-1">
            <li class="flex items-center gap-2">
              <span class="text-yaffle-400">&#10003;</span>
              2 environments
            </li>
            <li class="flex items-center gap-2">
              <span class="text-yaffle-400">&#10003;</span>
              4 active previews
            </li>
            <li class="flex items-center gap-2">
              <span class="text-yaffle-400">&#10003;</span>
              GitHub integration
            </li>
          </ul>
          <a 
            href="/app" 
            class="block w-full text-center px-4 py-2 rounded-lg border border-border text-text-muted text-sm font-medium hover:border-yaffle-600 hover:text-text transition-colors mt-auto"
          >
            Get started
          </a>
        </div>
        
        <!-- Team - highlighted with red accent -->
        <div class="p-6 rounded-xl bg-surface-raised border-2 border-accent-500 relative flex flex-col">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-accent-500 text-white text-xs font-medium rounded-full">
            Most popular
          </div>
          <h3 class="text-lg font-semibold text-text mb-1">Team</h3>
          <p class="text-text-dim text-sm mb-4">For small teams</p>
          <div class="text-3xl font-bold text-text mb-4">
            $99<span class="text-sm font-normal text-text-dim">/mo</span>
          </div>
          <ul class="space-y-2 text-sm text-text-muted mb-6 flex-1">
            <li class="flex items-center gap-2">
              <span class="text-yaffle-400">&#10003;</span>
              10 environments
            </li>
            <li class="flex items-center gap-2">
              <span class="text-yaffle-400">&#10003;</span>
              Unlimited previews
            </li>
            <li class="flex items-center gap-2">
              <span class="text-yaffle-400">&#10003;</span>
              5 team members
            </li>
            <li class="flex items-center gap-2">
              <span class="text-yaffle-400">&#10003;</span>
              Email support
            </li>
          </ul>
          <a 
            href="/app" 
            class="block w-full text-center px-4 py-2 rounded-lg bg-accent-500 text-white text-sm font-medium hover:bg-accent-400 transition-colors mt-auto"
          >
            Start free trial
          </a>
        </div>
        
        <!-- Business -->
        <div class="p-6 rounded-xl bg-surface-raised border border-border flex flex-col">
          <h3 class="text-lg font-semibold text-text mb-1">Business</h3>
          <p class="text-text-dim text-sm mb-4">For growing teams</p>
          <div class="text-3xl font-bold text-text mb-4">
            $299<span class="text-sm font-normal text-text-dim">/mo</span>
          </div>
          <ul class="space-y-2 text-sm text-text-muted mb-6 flex-1">
            <li class="flex items-center gap-2">
              <span class="text-yaffle-400">&#10003;</span>
              Unlimited environments
            </li>
            <li class="flex items-center gap-2">
              <span class="text-yaffle-400">&#10003;</span>
              Unlimited previews
            </li>
            <li class="flex items-center gap-2">
              <span class="text-yaffle-400">&#10003;</span>
              Unlimited team members
            </li>
            <li class="flex items-center gap-2">
              <span class="text-yaffle-400">&#10003;</span>
              Priority support
            </li>
          </ul>
          <a 
            href="/app" 
            class="block w-full text-center px-4 py-2 rounded-lg border border-border text-text-muted text-sm font-medium hover:border-yaffle-600 hover:text-text transition-colors mt-auto"
          >
            Start free trial
          </a>
        </div>
      </div>
      
      <p class="text-center text-sm text-text-dim mt-6">
        All plans include a 14-day free trial. Your AWS costs are separate.
      </p>
    </div>
  </section>

  <!-- AI angle - brief -->
  <section class="py-12 px-6 border-t border-border-subtle">
