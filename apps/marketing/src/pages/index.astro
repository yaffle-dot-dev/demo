  <script is:inline>
    // Loops waitlist form handler
    (function() {
      const LOOPS_FORM_ENDPOINT = "https://app.loops.so/api/newsletter-form/cmmtf4av40g8p0i2blg05vio5"

      const form = document.getElementById("waitlist-form")
      const formMessage = document.getElementById("form-message")
      const formNote = document.getElementById("form-note")

      if (!form) return

      form.addEventListener("submit", async function(e) {
        e.preventDefault()
        
        const emailInput = form.querySelector('input[name="email"]')
        const submitButton = form.querySelector('button[type="submit"]')
        const email = emailInput ? emailInput.value : ""

        if (!email) return

        // Disable form while submitting
        submitButton.disabled = true
        submitButton.textContent = "Submitting..."

        try {
          const formBody = "email=" + encodeURIComponent(email) + "&userGroup=" + encodeURIComponent("Waitlist")

          const response = await fetch(LOOPS_FORM_ENDPOINT, {
            method: "POST",
            body: formBody,
            headers: {
              "Content-Type": "application/x-www-form-urlencoded",
            },
          })

          if (response.status === 429) {
            showMessage("Too many signups, please try again in a little while.", "error")
            return
          }

          const data = await response.json()

          if (data.success) {
            showMessage("You're on the list! We'll notify you when Yaffle launches.", "success")
            form.style.display = "none"
            formNote.style.display = "none"
          } else {
            showMessage(data.message || "Something went wrong. Please try again.", "error")
          }
        } catch (error) {
          showMessage("Something went wrong. Please try again.", "error")
        } finally {
          submitButton.disabled = false
          submitButton.textContent = "Notify me"
        }
      })

      function showMessage(message, type) {
        formMessage.textContent = message
        formMessage.classList.remove("hidden", "text-yaffle-400", "text-red-400")
        formMessage.classList.add(type === "success" ? "text-yaffle-400" : "text-red-400")
      }
    })()
  </script>
