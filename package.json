{
  "name": "yaffle",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "vp run typecheck",
    "ci": "vp exec tsx scripts/ci/main.ts",
    "yaffle": "cargo run -p yaffle-cli --",
    "dev:control-plane": "vp run @yaffle/control-plane#dev",
    "dev:web": "vp run @yaffle/web#dev",
    "dev:mlp": "vp run @yaffle/marketing#dev",
    "dev:docs": "vp run @yaffle/docs#dev",
    "build": "vp run -r build",
    "typecheck": "vp run -r typecheck && vp exec tsc -p tsconfig.scripts.json --noEmit",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "smoke": "vp run @yaffle/control-plane#smoke",
    "smoke:browser": "vp run @yaffle/web#smoke",
    "smoke:local-first": "vp exec tsx scripts/smoke/local-first.ts",
    "test": "vp run --filter './apps/*' --filter './packages/*' -r test && vp run test:scripts",
    "test:scripts": "vp test run scripts/**/*.test.ts",
    "db:generate": "vp run @yaffle/control-plane#db:generate",
    "db:migrate": "vp run @yaffle/control-plane#db:migrate",
    "build-images": "vp exec tsx scripts/build-images.ts",
    "build-cp": "vp exec tsx scripts/build-cp.ts",
    "build-web": "vp exec tsx scripts/build-web.ts",
    "build-runner": "vp exec tsx scripts/build-runner.ts",
    "build-scanner": "vp exec tsx scripts/build-scanner.ts",
    "build-tc": "vp exec tsx scripts/build-tc.ts",
    "build-provider-discovery-agent": "vp exec tsx scripts/build-provider-discovery-agent.ts",
    "deploy": "vp exec tsx scripts/deploy.ts",
    "deploy-all": "vp exec tsx scripts/deploy-all.ts",
    "deploy-cp": "vp exec tsx scripts/deploy-cp.ts",
    "deploy-web": "vp exec tsx scripts/deploy-web.ts",
    "deploy-runner": "vp exec tsx scripts/deploy-runner.ts",
    "deploy-scanner": "vp exec tsx scripts/deploy-scanner.ts",
    "deploy-tc": "vp exec tsx scripts/deploy-tc.ts",
    "deploy-provider-discovery-agent": "vp exec tsx scripts/deploy-provider-discovery-agent.ts",
    "deploy-docs": "vp exec tsx scripts/deploy-docs.ts",
    "deploy-marketing": "vp exec tsx scripts/deploy-marketing.ts",
    "publish-scanner-layers": "vp exec tsx scripts/publish-scanner-layers.ts",
    "test-scanner-lambda": "vp exec tsx scripts/test-scanner-lambda.ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@yaffle/test": "workspace:*",
    "@dotenvx/dotenvx": "^1.57.0",
    "esbuild": "^0.28.0",
    "tar-stream": "^3.1.8",
    "testcontainers": "^11.7.2",
    "tsx": "^4.21.0",
    "vite-plus": "^0.1.20",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@aws-sdk/client-ecr": "^3.1019.0",
    "@aws-sdk/client-ecs": "^3.1019.0",
    "@aws-sdk/client-lambda": "^3.1019.0",
    "@aws-sdk/client-ssm": "^3.1019.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.1",
    "playwriter": "^0.0.80"
  }
}
