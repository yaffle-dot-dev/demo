{
  "name": "yaffle",
  "private": true,
  "workspaces": [
    "apps/*",
    "docs/*",
    "packages/*"
  ],
  "scripts": {
    "ci": "bun run scripts/ci/main.ts",
    "dev:control-plane": "bun run --filter=@yaffle/control-plane dev",
    "dev:web": "bun run --filter=@yaffle/web dev",
    "dev:mlp": "bun run --filter=@yaffle/marketing dev",
    "dev:docs": "bun run --filter=@yaffle/docs dev",
    "build": "bun run --filter='*' build",
    "typecheck": "bun run --filter='*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "smoke": "bun run --filter=@yaffle/control-plane smoke",
    "smoke:browser": "bun run --filter=@yaffle/web smoke",
    "test": "bun run --filter='*' test",
    "test:scripts": "bun test scripts/**/*.test.ts",
    "db:generate": "bun run --filter=@yaffle/control-plane db:generate",
    "db:migrate": "bun run --filter=@yaffle/control-plane db:migrate",
    "yaffle-cli": "bun run packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.57.0",
    "bun-types": "^1.3.10",
    "tar-stream": "^3.1.8"
  },
  "dependencies": {
    "@aws-sdk/client-ecr": "^3.1019.0",
    "@aws-sdk/client-ecs": "^3.1019.0",
    "@aws-sdk/client-lambda": "^3.1019.0",
    "@aws-sdk/client-ssm": "^3.1019.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.1",
    "playwriter": "^0.0.80"
  }
}
