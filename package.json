{
  "name": "yaffle",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:control-plane": "bun run --filter=@yaffle/control-plane dev",
    "dev:web": "bun run --filter=@yaffle/web dev",
    "build": "bun run --filter='*' build",
    "typecheck": "bun run --filter='*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun run --filter='*' test",
    "db:generate": "bun run --filter=@yaffle/control-plane db:generate",
    "db:migrate": "bun run --filter=@yaffle/control-plane db:migrate"
  },
  "devDependencies": {
    "bun-types": "^1.3.10"
  }
}
