{
  "name": "yaffle",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --filter=@yaffle/api dev",
    "dev:web": "bun run --filter=@yaffle/web dev",
    "build": "bun run --filter='*' build",
    "typecheck": "bun run --filter='*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun run --filter='*' test",
    "db:generate": "bun run --filter=@yaffle/api db:generate",
    "db:migrate": "bun run --filter=@yaffle/api db:migrate"
  }
}
