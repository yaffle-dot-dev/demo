# Caddy reverse proxy for local development
# Provides HTTPS on localhost:6969 for all Yaffle services
#
# Usage: caddy run (started automatically by devenv up)
# First run: caddy trust (to install Caddy's local CA)
{
	# Use Caddy's internal CA for localhost HTTPS
	local_certs
	
	# Increase HTTP keep-alive timeout for Terraform client connections
	# Terraform's go-tfe client can have gaps between requests during apply
	servers {
		timeouts {
			idle 5m
		}
		# Force HTTP/1.1 only - disable HTTP/2 and HTTP/3
		# This works around Terraform's go-tfe client having issues with HTTP/2 streams
		protocols h1
	}
}

https://localhost:6969 {
	# Log all requests for debugging
	log {
		output stdout
		format console
		level DEBUG
	}

	# TFC-compatible API (terraform login, state backend)
	# Force HTTP/1.1 for TFC routes to avoid HTTP/2 stream issues with Terraform
	handle /.well-known/* {
		reverse_proxy localhost:3000
	}

	handle /tfc/* {
		reverse_proxy localhost:3000
	}

	# Control plane API
	handle /api/* {
		reverse_proxy localhost:3000
	}

	# SvelteKit web app at /app (base path configured in svelte.config.js)
	handle /app/* {
		reverse_proxy localhost:5173
	}

	handle /app {
		reverse_proxy localhost:5173
	}

	# Vite/SvelteKit dev server paths
	handle /@fs/* {
		reverse_proxy localhost:5173
	}

	handle /@vite/* {
		reverse_proxy localhost:5173
	}

	handle /@id/* {
		reverse_proxy localhost:5173
	}

	handle /node_modules/* {
		reverse_proxy localhost:5173
	}

	handle /.svelte-kit/* {
		reverse_proxy localhost:5173
	}

	# Marketing site at root
	handle {
		reverse_proxy localhost:4000
	}
}
